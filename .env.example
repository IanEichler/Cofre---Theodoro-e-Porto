# Secrets for the Cloudflare Worker / Sites runtime. Never commit real values.
# 32 random bytes encoded as base64. Preserve this key to keep existing vault data readable.
COFRE_ENCRYPTION_KEY=
# Main administrator email. No password is predefined.
COFRE_BOOTSTRAP_EMAIL=
# SHA-256 of the one-time bootstrap token, encoded as base64.
COFRE_BOOTSTRAP_HASH=
# Bootstrap expiration as Unix milliseconds.
COFRE_BOOTSTRAP_EXPIRES=
